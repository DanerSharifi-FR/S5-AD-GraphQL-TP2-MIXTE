# Mode JSON ou Mongo
USE_MONGO=1
MONGO_URI=mongodb://localhost
MONGO_DB_NAME=cinema_mixte

# Pour docker
MONGO_URI_DOCKER=mongodb://mongo-mixte
MOVIE_SERVICE_URL_DOCKER=http://movie-mixte
USER_SERVICE_URL_DOCKER=http://user-mixte
SCHEDULE_SERVICE_URL_DOCKER=schedule-mixte

# Ports des services
MONGO_PORT=27017
MOVIE_PORT=3200
USER_PORT=3203
SCHEDULE_PORT=3202
BOOKING_PORT=3201

# Host de flask
HOST="0.0.0.0"

# URLs des services en mode hors Docker
USER_SERVICE_URL=http://localhost
SCHEDULE_SERVICE_URL=localhost
MOVIE_SERVICE_URL=http://localhost
BOOKING_SERVICE_URL=http://localhost
